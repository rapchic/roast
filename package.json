{
  "name": "@rapchic/roast",
  "version": "0.1.3",
  "description": "AI code review skill for Cursor, Claude Code & Codex — evidence-based /roast with file:line citations. CLI installs the skill; no LLM API in the package.",
  "type": "module",
  "bin": {
    "roast": "installer/bin/cli.js",
    "roastit": "installer/bin/cli.js"
  },
  "files": [
    "installer/",
    "skills/",
    "rules/",
    "commands/",
    "scripts/postinstall.js",
    "scripts/gather-context.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.js",
    "lint": "node scripts/lint.js",
    "smoke": "node scripts/smoke-install.js",
    "pack:check": "npm pack --dry-run",
    "ci": "node scripts/ci-local.js",
    "prepublishOnly": "npm run ci",
    "postinstall": "node scripts/postinstall.js",
    "sync:project-cursor": "node installer/bin/cli.js install --tools cursor --path .",
    "dev:setup": "node scripts/dev-setup.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agents",
    "cursor",
    "claude",
    "claude-code",
    "codex",
    "openai",
    "code-review",
    "code-roast",
    "skills",
    "agent-skills",
    "cli",
    "developer-tools",
    "llm",
    "roast",
    "roastit",
    "criticism-manager",
    "ai-code-review",
    "code-review-tool",
    "cursor-ide",
    "slash-commands",
    "agentic",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapchic/roast.git"
  },
  "bugs": {
    "url": "https://github.com/rapchic/roast/issues"
  },
  "homepage": "https://github.com/rapchic/roast#readme",
  "publishConfig": {
    "access": "public"
  }
}
